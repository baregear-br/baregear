x = input "Enter Your First Number: "
op = input "Enter Your Operator To Calculate: "
y = input "Enter Your Second Number: "

switch op:
    case '+':
        print 'Result: ' + (x + y)

    case '-':
        print 'Result: ' + (x - y)

    case '*':
        print 'Result: ' + (x * y)

    case '/':
        print 'Result: ' + (x / y)

    default:
        print 'Invalid Operator: '
